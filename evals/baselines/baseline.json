        "cypher_query": "MATCH (e:Employee)-[:HAS_POSITION]->(pos:Position)\nWITH e.name AS employee,\n     pos.name AS position,\n     max(e.years_experience) AS years_experience,\n     max(pos.min_years) AS min_years,\n     max(pos.max_years) AS max_years\nWITH employee, position, years_experience, min_years, max_years,\n     CASE\n       WHEN years_experience IS NULL OR min_years IS NULL OR max_years IS NULL THEN '기준정보없음'\n       WHEN years_experience < min_years THEN '기준미달'\n       WHEN years_experience > max_years THEN '기준초과'\n       ELSE '기준일치'\n     END AS match_status\nWITH position, min_years, max_years, match_status, COUNT(DISTINCT employee) AS employee_count\nWITH position, collect({min_years: min_years, max_years: max_years, match_status: match_status, employee_count: employee_count}) AS rows,\n     sum(employee_count) AS total_count\nUNWIND rows AS row\nWITH position, total_count, row\nRETURN position,\n       row.min_years AS min_years,\n       row.max_years AS max_years,\n       row.match_status AS match_status,\n       row.employee_count AS employee_count,\n       round(100.0 * row.employee_count / total_count, 2) AS ratio_within_position\nORDER BY position, match_status",
