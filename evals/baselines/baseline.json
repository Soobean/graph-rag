        "cypher_query": "MATCH (p:Project)-[req:REQUIRES]->(s:Skill)\nWHERE toLower(p.name) = toLower($projectName)\nOPTIONAL MATCH (p)<-[w:WORKS_ON]-(e:Employee)\nOPTIONAL MATCH (e)-[hs:HAS_SKILL]->(s)\nWITH p, s, req, e.name AS employeeName, hs,\n     CASE req.required_proficiency\n       WHEN '초급' THEN 1\n       WHEN '중급' THEN 2\n       WHEN '고급' THEN 3\n       ELSE 0\n     END AS requiredLevel,\n     CASE hs.proficiency\n       WHEN '초급' THEN 1\n       WHEN '중급' THEN 2\n       WHEN '고급' THEN 3\n       WHEN '전문가' THEN 4\n       ELSE 0\n     END AS employeeLevel\nWITH p.name AS project, s.name AS skill, req.required_proficiency AS required_proficiency,\n     COUNT(DISTINCT employeeName) AS assigned_employee_count,\n     COUNT(DISTINCT CASE WHEN employeeName IS NOT NULL AND hs IS NOT NULL AND employeeLevel >= requiredLevel THEN employeeName END) AS covering_employee_count,\n     COLLECT(DISTINCT CASE WHEN employeeName IS NOT NULL AND hs IS NOT NULL AND employeeLevel >= requiredLevel THEN employeeName END) AS covering_employees,\n     COLLECT(DISTINCT CASE WHEN employeeName IS NOT NULL AND (hs IS NULL OR employeeLevel < requiredLevel) THEN employeeName END) AS gap_employees\nRETURN project, skill, required_proficiency, assigned_employee_count, covering_employee_count, covering_employees, gap_employees,\n       CASE WHEN covering_employee_count > 0 THEN true ELSE false END AS is_covered\nORDER BY is_covered ASC, skill ASC",
