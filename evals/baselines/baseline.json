        "cypher_query": "MATCH (e:Employee)-[:HAS_POSITION]->(pos:Position)\nWITH e.name AS employee,\n     max(e.years_experience) AS years_experience,\n     pos.name AS position,\n     max(pos.min_years) AS min_years,\n     max(pos.max_years) AS max_years\nWITH employee, years_experience, position, min_years, max_years,\n     CASE\n       WHEN years_experience IS NULL OR min_years IS NULL OR max_years IS NULL THEN '기준정보없음'\n       WHEN years_experience < min_years THEN '기준 미만'\n       WHEN years_experience > max_years THEN '기준 초과'\n       ELSE '기준 일치'\n     END AS match_status\nWITH position, min_years, max_years, match_status, COUNT(DISTINCT employee) AS employee_count\nWITH collect({position: position, min_years: min_years, max_years: max_years, match_status: match_status, employee_count: employee_count}) AS rows,\n     sum(employee_count) AS total_count\nUNWIND rows AS row\nWITH row, total_count\nRETURN row.position AS position,\n       row.min_years AS min_years,\n       row.max_years AS max_years,\n       row.match_status AS match_status,\n       row.employee_count AS employee_count,\n       CASE WHEN total_count = 0 THEN 0 ELSE round(100.0 * row.employee_count / total_count) END AS overall_ratio_percent\nORDER BY position, match_status",
